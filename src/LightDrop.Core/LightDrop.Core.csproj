<Project Sdk="Microsoft.NET.Sdk">

  <!-- LightDrop.Core is deliberately platform independent and has no ASP.NET Core
       dependency. It owns the wire contracts, the domain abstractions (ports), and
       the orchestration logic. All file I/O lives in infrastructure adapters. -->

  <PropertyGroup>
    <RootNamespace>LightDrop.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
