<Project Sdk="Microsoft.NET.Sdk">

  <!-- A class library, not an application. LightDrop ships as a single executable, so the CLI
       is the only entry point and it hosts this daemon in-process. FrameworkReference is how a
       library consumes ASP.NET Core without becoming a web app of its own. -->

  <PropertyGroup>
    <RootNamespace>LightDrop.Daemon</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Source-generates the minimal API request delegates. Without this, MapGet reflects over
         the handler at runtime, which trips the trim and AOT analyzers enabled above. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast.New" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LightDrop.Core\LightDrop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled into the assembly rather than published beside it: LightDrop ships as a single
         executable, so there is no content directory to serve from. LogicalName is pinned so the
         resource name does not move if the folder is renamed. -->
    <EmbeddedResource Include="Ui/index.html" LogicalName="LightDrop.Daemon.Ui.index.html" />
  </ItemGroup>

  <!-- LoopbackOriginPolicy is internal on purpose: it is an implementation detail of this
       library, not a port other assemblies should consume. Its unit tests call it directly
       rather than only through HTTP, so the test assembly needs access. -->
  <ItemGroup>
    <InternalsVisibleTo Include="LightDrop.Daemon.Tests" />
  </ItemGroup>

</Project>
